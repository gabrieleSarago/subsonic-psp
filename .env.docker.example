# ---------------------------------------------------------------------------
# Settings for running the feeds with docker compose.
# ---------------------------------------------------------------------------
# Copy this file to ".env" next to docker-compose.yml and fill in the blanks:
#
#     cp .env.docker.example .env
#     docker compose up --build
#
# These variables are read by docker compose and handed to the container. They
# are never written into the image, so changing one only needs a restart.
# ---------------------------------------------------------------------------

# The address the device reaches this application at, without a scheme and
# without a port: Traefik answers to this name and publishes it over plain HTTP.
#
# It becomes APP_URL inside the container, and that value is written into the
# feeds as the enclosure URL. If it is not the name the device really uses, the
# pages still open but no track will play, so this is the one line to get right.
PSP_HOSTNAME=psp-rss.home.lan

# The port the server listens on inside the container, and the one Traefik is
# told to route to. Nothing is published on the host, so it is not an address
# anyone types. Change it only if it clashes with another container.
APP_PORT=9000

# Shown as the title of the index page and of every feed.
APP_NAME="PSP RSS"

# ---------------------------------------------------------------------------
# Navidrome
# ---------------------------------------------------------------------------
# The base address of the server, without the "/rest" suffix.
#
# The port is not optional when the address is a container name. Navidrome
# listens on 4533, and a name without a port means port 80, where nothing is
# listening: the answer is "Navidrome non raggiungibile", which reads like a
# server that is down rather than like an address that is wrong. Check with
#
#     docker compose exec psp-rss php artisan navidrome:diagnose
#
# which prints the address it tried and the reason.
#
# Through the Traefik of this host, where the two containers share the "proxy"
# network, the name of the container is enough as long as the port is written:
#
#     SUBSONIC_HOST=http://navidrome:4533
#
# From the same network the published name works too, and needs no port, because
# Traefik answers on 80 there:
#
#     SUBSONIC_HOST=http://navidrome.home.lan
SUBSONIC_HOST=http://navidrome:4533

# A user of the server. It does not need to be an administrator: reading the
# library and streaming a track are enough.
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=

# ---------------------------------------------------------------------------
# Device limits
# ---------------------------------------------------------------------------
# The PSP plays MP3 only, so FLAC and friends are converted by Navidrome at
# this bitrate. A track already in MP3 is sent untouched, whatever this says.
SUBSONIC_PSP_BITRATE=128

# The device stops reading a feed after about a hundred entries. Anything
# longer is served as a sequence of feeds, each of this size.
PSP_FEED_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Radio
# ---------------------------------------------------------------------------
# The station list is bind mounted from ./storage/app/radios, so it belongs to
# the host: the container only reads it, and picks up an edit on the next
# request without a rebuild or a restart. It is edited and re-probed on the
# host, where the file is writable, with
#
#     php artisan radios:probe
#
# The path inside the container is fixed by docker-compose.yml.
#
# ffmpeg transcodes every station to MP3 in real time, whatever the codec of
# the source is, because the PSP only plays MP3.
RADIOS_FFMPEG_BIN=ffmpeg

# The bitrate of that transcode.
RADIOS_PSP_BITRATE=128

# Seconds spent reaching a stream while probing, and waiting for the first
# transcoded bytes before a station is reported as unavailable.
RADIOS_PROBE_TIMEOUT=8
RADIOS_FIRST_CHUNK_TIMEOUT=15

# Bytes. The most audio one playback of a station may carry, so the stream
# looks like a file of a known size to the device. One hour at 128 kbps.
RADIOS_STREAM_MAX_BYTES=57600000

