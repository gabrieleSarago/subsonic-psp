APP_NAME="PSP RSS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false

# ---------------------------------------------------------------------------
# Dove il dispositivo raggiunge questa applicazione
# ---------------------------------------------------------------------------
# The base URL of this application, as reachable from the PSP. It is embedded
# in the feeds as the enclosure URL, so it must be the URL the PSP actually
# uses: the device cannot follow a redirect from an address it does not know.
#
# "localhost" serves a browser on this same machine. For the PSP itself it has
# to be an address the device can resolve and reach, so this is the value to
# change when testing stops being done from here.
#
# It is also forced on every request, so the value of the Host header sent by
# the device has no effect on the links found in a feed.
APP_URL=http://localhost:9000

# Port the container listens on. Only relevant under Docker, where it is the
# host port published in front of the application.
APP_PORT=9000

# ---------------------------------------------------------------------------
# Navidrome / Subsonic
# ---------------------------------------------------------------------------
# The base URL of the server, without the "/rest" suffix. No scheme, no port
# and no trailing slash mistakes: "http://navidrome.home.lan" is right.
SUBSONIC_HOST=http://navidrome.home.lan

# Credentials of the Subsonic API. They are never sent over the network as they
# are: every request carries a token salted with a fresh random value.
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=

# Bitrate used to transcode non-MP3 tracks to MP3 on the fly. The PSP only
# plays MP3, so FLAC and friends are converted by Navidrome at this bitrate.
SUBSONIC_PSP_BITRATE=128

# The PSP stops reading a feed after roughly 100 items, so longer albums and
# playlists are split into parts of this size.
PSP_FEED_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Radio
# ---------------------------------------------------------------------------
# The curated list of stations. It is edited by hand; the name, tagline and
# favicon of a station are discovered from the stream by
#
#     php artisan radios:probe
#
# and written back into the file. The default is an absolute path; a relative
# value is resolved from the application root.
#RADIOS_FILE=

# ffmpeg transcodes every station to MP3 in real time, whatever the codec of
# the source is, because the PSP only plays MP3.
RADIOS_FFMPEG_BIN=ffmpeg
RADIOS_PSP_BITRATE=128

# Seconds. How long a probe may wait for a stream, and how long the first
# transcoded bytes may take to appear before a station is reported as down.
RADIOS_PROBE_TIMEOUT=8
RADIOS_FIRST_CHUNK_TIMEOUT=15

# The length, in bytes, declared for a live stream. The device refuses an
# answer whose length it cannot see, and a body without one is framed as
# chunked on the way out. The declared value is never reached: it only keeps
# the audio unwrapped, and at 128 kbps it covers more than a day of listening.
RADIOS_STREAM_DECLARED_LENGTH=2000000000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# This application stores no data of its own, so the file drivers are enough
# and no database is required to boot.
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
